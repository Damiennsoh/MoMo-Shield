# Copy to .env.demo and replace every placeholder before starting the demo.
# Use your laptop's Wi-Fi/LAN IPv4 address (the same address phones will reach).
DEMO_LAN_IP=192.168.1.50
ASTERISK_MEDIA_IP=192.168.1.50

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_DEVICE_TOKEN=REPLACE_WITH_RANDOM_URLSAFE_TOKEN
# Generate SIP and ARI passwords separately with: python -c "import secrets; print(secrets.token_hex(24))"
ASTERISK_SIP_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
ASTERISK_ARI_USERNAME=momoshield
ASTERISK_ARI_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX_PASSWORD

# Optional: leave empty to use deterministic intent fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=7
