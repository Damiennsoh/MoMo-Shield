# Rancard Glance API
GLANCE_API_KEY=your_glance_sandbox_key
GLANCE_BASE_URL=https://api.glance.rancardmobility.com/v1

# Google Gemini API
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.0-flash-exp

# InnoFemme API used by existing webhook intervention code (Bearer auth)
SANDBOX_API_KEY=
SANDBOX_BASE_URL=https://hackathon.innofemme.org/api/w/YOUR_TEAM

# Optional carrier network API: Basic auth, separate from bridge/team keys.
# Keep empty unless these network credentials are issued and verified.
SANDBOX_NETWORK_CLIENT_ID=
SANDBOX_NETWORK_API_KEY=
PLUGIN_LOOKUP_TIMEOUT_SECONDS=1.0

# Shared correlation state across workers (empty = in-memory, single worker)
REDIS_URL=

# MTN MoMo Collection API (sandbox only; keep these values on the backend)
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_CALLBACK_URL=
MTN_MOMO_REQUEST_API_KEY=

# System
RISK_THRESHOLD_HIGH=75
RISK_THRESHOLD_MEDIUM=40
